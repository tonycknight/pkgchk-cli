<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>pkgchk</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pkgchk</ToolCommandName>
    <PackageId>pkgchk-cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningsAsErrors>3239;$(WarningsAsErrors);FS0025;FS0026</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningsAsErrors>3239;$(WarningsAsErrors);FS0025;FS0026</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <NoWarn>NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="False" />
    <Content Include="ScaVulnerabilitySample.json" />
    <Content Include="PackageDependencyTreeSample.json" />
    <Compile Include="Utils.fs" />
    <Compile Include="Io.fs" />
    <Compile Include="ScaModels.fs" />
    <Compile Include="Process.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="Rendering.fs" />
    <Compile Include="Console.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Markdown.fs" />
    <Compile Include="PackageCommandSettings.fs" />
    <Compile Include="CliCommands.fs" />
    <Compile Include="Licences.fs" />
    <Compile Include="Contexts.fs" />
    <Compile Include="Github.fs" />
    <Compile Include="PackageAutomationScanning.fs" />
    <Compile Include="DotNet.fs" />
    <Compile Include="Reporting.fs" />
    <Compile Include="PackageScanCommand.fs" />
    <Compile Include="PackageLicenceCommand.fs" />
    <Compile Include="PackageListCommand.fs" />
    <Compile Include="PackageUpgradeCommand.fs" />
    <Compile Include="NugetLookupCommand.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\pkgchk.core\pkgchk.core.fsproj" />
  </ItemGroup>

</Project>
